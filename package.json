  "description": "How a player changes government: a revolution kept as a pending effect, the interim government while it lasts, how long it lasts, choosing the new one, which governments are available, and what a change sets off, for a ruleset to wrap in its own rules.",
  "repository": "git@github.com:civ-clone/base-government-change.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-game": "^0.1.17",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
