    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/base-player-action-choose-government": "^0.1.0",
    "@civ-clone/base-player-action-revolution": "^0.1.1",
    "@civ-clone/core-engine": "^0.1.6",
    "@civ-clone/core-government": "^0.1.6",
    "@civ-clone/core-pending-effect": "^0.1.2",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-player-world": "^0.1.14",
    "@civ-clone/core-requirement": "^0.1.3",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-science": "^0.1.9",
    "@civ-clone/core-turn-based-game": "^0.1.10"
  }
